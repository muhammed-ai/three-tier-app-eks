# Example terraform.tfvars file
# Copy this to terraform.tfvars and customize

aws_region  = "us-east-1"
environment = "dev"

# VPC Configuration
vpc_cidr            = "10.0.0.0/16"
availability_zones  = ["us-east-1a", "us-east-1b", "us-east-1c"]
enable_nat_gateway  = true
enable_flow_logs    = true

# EKS Configuration
cluster_name    = "three-tier-cluster"
cluster_version = "1.28"

# Restrict cluster endpoint access in production
cluster_endpoint_public_access_cidrs = ["YOUR_IP/32"]

# Node Groups
node_groups = {
  general = {
    instance_types = ["t3.medium"]
    capacity_type  = "ON_DEMAND"
    desired_size   = 2
    min_size       = 1
    max_size       = 5
    disk_size      = 50
    labels = {
      type = "general"
    }
    taints = {}
  }
}

# RDS Configuration
db_name     = "appdb"
db_username = "appuser"
# db_password is auto-generated and stored in Secrets Manager

# Production recommendations:
# - Enable Multi-AZ for RDS
# - Use larger instance types
# - Restrict cluster endpoint CIDRs
# - Enable deletion protection
